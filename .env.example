# Copy this file to `.env` and fill in the secrets. Never commit the real `.env`.

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_TIMEOUT=30
COLLECTION_NAME=wolf359_scripts

# --- Jina (embeddings + rerank) ---
JINA_API_KEY=
EMBED_MODEL=jina-embeddings-v3
EMBED_DIM=1024
RERANK_MODEL=jina-reranker-v2-base-multilingual

# --- Cloudflare Workers AI (generation) ---
# No quotes around values below - quotes get included literally and will
# break Bearer-token auth (config.py strips them defensively, but cleanest
# to just not add them here).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# --- Retrieval tuning ---
FETCH_K=15
TOP_K=5
QUERY_EXPANSION_VARIANTS=2
SCENE_WINDOW=1
# chunk = rerank individual lines (default); window = rerank merged scene context
RERANK_SCOPE=chunk
WINDOW_RERANK_POOL=8

# --- Conversation history ---
# Number of TURNS remembered per session. A summarizer turn = 1 user + 1
# assistant message. A group-chat turn = 1 user + 3 character replies.
HISTORY_WINDOW_TURNS=5

# --- Token usage ---
MAX_OUTPUT_TOKENS=1024
SESSION_TOKEN_BUDGET=25000
